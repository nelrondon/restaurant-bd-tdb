PORT=
API_KEY=12345
POSTGRES_URL=

# Autenticación
# Secreto para firmar los access tokens. Aleatorio de 32+ bytes, distinto por
# ambiente y nunca versionado. Por ejemplo: openssl rand -hex 32
JWT_ACCESS_SECRET=
# Vida del access token, en segundos (900 = 15 minutos)
JWT_ACCESS_TTL=900
# Vida del refresh token, en días
REFRESH_TTL_DIAS=30
# Costo de bcrypt para las contraseñas (mínimo 12)
BCRYPT_COST=12
# Dominio del frontend. Si se deja vacío se aceptan todos los orígenes (solo desarrollo)
CORS_ORIGIN=
# Número de proxies por delante de la API (nginx = 1). Necesario para que el rate
# limit cuente la IP real del cliente. Vacío o 0 si la API se expone directamente
TRUST_PROXY=

# Solo para "npm run seed:usuarios". Si se deja vacío, el script genera una
# contraseña aleatoria y la imprime una única vez
SEED_ADMIN_USER=admin
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_PASSWORD=
